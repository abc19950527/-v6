# -*- coding: utf-8 -*-
"""
Kivy语言定义文件
用于定义自定义组件样式
"""

<Button>:
    background_color: 0.098, 0.502, 1.0, 1
    color: 1, 1, 1, 1
    font_size: '18sp'
    bold: True

<PrimaryButton>:
    background_color: 0.098, 0.502, 1.0, 1

<SuccessButton>:
    background_color: 0.298, 0.686, 0.314, 1

<WarningButton>:
    background_color: 0.957, 0.647, 0.0, 1

<DangerButton>:
    background_color: 0.957, 0.263, 0.212, 1

<TextInput>:
    padding: [15, 12]
    font_size: '16sp'
    multiline: False

<Label>:
    color: 0.133, 0.133, 0.133, 1
    font_size: '16sp'
